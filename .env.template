# Gemini API Key (Required for AI Agent operations)
GEMINI_API_KEY=your_gemini_api_key_here
# Flagship model defaults (options: gemini-4-carbon, gemini-4-neon, gemini-4-argon, gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-4-neon
ORCHESTRATOR_MODEL=gemini-4-carbon
SPECIALIST_MODEL=gemini-4-neon

# FortiGate Connection Details
# Leave empty to automatically use high-fidelity MOCK MODE
FORTIGATE_IP=
FORTIGATE_TOKEN=
FORTIGATE_PORT=443
FORTIGATE_VDOM=root
USE_SSL=True
# TLS certificate verification is enabled by default for management-plane security.
# For private PKI, set CA_BUNDLE to your CA certificate (.pem). Set VERIFY_SSL=False only for lab troubleshooting.
VERIFY_SSL=True
CA_BUNDLE=

# Explicitly force Mock Mode for offline testing
MOCK_MODE=True

# Enable active write/mitigation actions (disable for safety read-only mode)
ENABLE_WRITE_ACTIONS=False

# Dry run mode: simulate write actions without executing REST calls
DRY_RUN=False

# Automatically take and verify a configuration snapshot backup before executing write actions.
# Fail-closed: if backup fails, write actions are aborted. Set to False only to explicitly bypass.
BACKUP_BEFORE_WRITE=True

# Optional: Export diagnostic report output target (.html, .md, or .json)
OUTPUT_FILE=


